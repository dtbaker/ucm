# Ultimate Client Manager documentation - Apache configuration.
#
# This file is copied into the build and uploaded with it, so it ends up alongside
# index.html in whatever folder the documentation is published to. It is only read by
# Apache; it does nothing on nginx, and nothing on a CDN.
#
# There is no PHP here and nothing to execute. The documentation is static files.

# Serve a folder's index.html. Every article is published as <slug>/index.html so that
# the address in the browser has no file extension in it.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
	# WordPress's own .htaccess, one folder up, hands everything it does not recognise to
	# index.php. Its rules already exempt paths that exist on disk, so an article here is
	# served directly - but mod_rewrite rules are per-directory and the presence of this
	# block stops the parent's from being considered at all. Belt and braces, and it also
	# means this folder keeps working if the site above it is replaced by something else.
	RewriteEngine Off
</IfModule>

# A reader who types a URL that does not exist gets the documentation's own 404 page
# rather than the host's. The path is relative to the document root, so if the
# documentation is published somewhere other than /docs/ this line moves with it - which
# is why the deploy script writes it rather than leaving it hard coded.
ErrorDocument 404 /docs/404.html

<IfModule mod_mime.c>
	AddType application/json .json
	AddType application/wasm .wasm
	AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	# The application reads /api/v1/*.json from PHP, so it needs no CORS header. This one
	# costs nothing and means a browser-side reader is not blocked later.
	<FilesMatch "\.json$">
		Header set Access-Control-Allow-Origin "*"
	</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	# Deliberately short, and deliberately the same for everything.
	#
	# Most of the assets here are content hashed and could safely be cached for a year,
	# but Pagefind's loader scripts are not: pagefind/pagefind.js keeps its name and
	# changes its contents on every build. A rule written by file type cannot tell those
	# two apart, so a long life set that way eventually serves a reader a search index
	# that no longer matches the site. Ten minutes on everything costs almost nothing on
	# a site this size and cannot go wrong.
	ExpiresDefault "access plus 10 minutes"
	ExpiresByType application/json "access plus 1 hour"
</IfModule>
