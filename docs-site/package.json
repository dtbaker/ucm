{
	"name": "ucm-docs",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Documentation for Ultimate Client Manager. One content tree, four build outputs - see README.md.",
	"scripts": {
		"dev": "astro dev",
		"build": "npm run build:app && npm run build:web && npm run build:offline",
		"build:app": "node scripts/build-app-artifacts.mjs",
		"build:web": "astro build",
		"build:offline": "node scripts/build-offline.mjs",
		"check": "node scripts/build-app-artifacts.mjs --check && node scripts/check-content.mjs",
		"posters": "node scripts/fetch-posters.mjs",
		"preview": "astro preview"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.6",
		"astro": "^7.3.8"
	},
	"devDependencies": {
		"gray-matter": "^4.0.3",
		"marked": "^16.4.2",
		"turndown": "^7.2.2"
	}
}
