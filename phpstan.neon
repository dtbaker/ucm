parameters:
    level: 2
    paths:
        - includes/
        - ajax.php
        - cron.php
        - ext.php
        - index.php
        - init.php
    excludePaths:
        - includes/plugin_pdf/dompdf/*
        - includes/plugin_encrypt/phpseclib/*
        - includes/plugin_email/class.*
    ignoreErrors:
        - '#Call to an undefined (method|static method)#'
        - '#Parameter .* has no type specified#'
        - '#Constant .* not found#'
        - '#Variable .* might not be defined#'
        - '#will always evaluate to (true|false)#'
        - '#Result of && is always#'
        - '#Unreachable statement#'
        - '#treatPhpDocTypesAsCertain#'
