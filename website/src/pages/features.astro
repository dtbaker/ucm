---
/**
 * The full feature list.
 *
 * Every entry is one sentence of what it does and a link into the documentation article
 * that explains it properly. The documentation is the long form; this page exists so a
 * buyer can scan for the thing they came looking for and then read about it.
 */
import Base from '../layouts/Base.astro';

const sections = [
	{
		heading: 'Customers and the people at them',
		items: [
			[ 'Customers and leads', 'Companies, the people at them, addresses and custom fields. A lead is a customer with a different type, so converting one is a change of type rather than a migration.', '/docs/using/customers/' ],
			[ 'Contacts', 'The individual people at a customer, each with their own login to the portal if you want them to have one.', '/docs/using/contacts/' ],
			[ 'Suppliers', 'The firms you buy from, kept alongside the ones you sell to.', '/docs/using/suppliers/' ],
			[ 'Extra fields', 'Add your own fields to customers, invoices, jobs and more, without touching the code.', '/docs/using/extra-fields/' ],
			[ 'Custom data forms', 'A structured store for the records the product does not model directly — equipment, licences, anything you need to keep.', '/docs/using/custom-data/' ],
		],
	},
	{
		heading: 'Winning the work',
		items: [
			[ 'Quotes', 'Build a quote from your product list, send it for approval, and turn the approved one into a job or an invoice.', '/docs/using/quotes/' ],
			[ 'Contracts', 'A document sent for approval and signature, built on the same machinery as quotes.', '/docs/using/contracts/' ],
			[ 'Online signature', 'The customer draws a signature in the browser to approve a quote or a contract. Nothing to print, nothing to scan.', '/docs/using/quotes/' ],
			[ 'Products and services', 'A price list to build quotes and invoices from, with categories.', '/docs/using/products/' ],
		],
	},
	{
		heading: 'Doing the work',
		items: [
			[ 'Jobs and tasks', 'Break work into tasks, assign them to staff, and keep a discussion thread against the job.', '/docs/using/jobs/' ],
			[ 'Change requests', 'A formal route for a customer asking for something that was not quoted.', '/docs/using/jobs/' ],
			[ 'Time tracking', 'A timer that attaches recorded time to a job, a task, a ticket or a quote, and carries it to the invoice.', '/docs/using/timers/' ],
			[ 'Support tickets', 'A ticket queue that can collect replies out of an email mailbox and file them against the right ticket.', '/docs/using/tickets/' ],
			[ 'Calendar', 'What is due and when, across jobs, tasks and invoices.', '/docs/using/calendar/' ],
		],
	},
	{
		heading: 'Getting paid',
		items: [
			[ 'Invoices', 'Create, send, record payments against, and chase the ones that are late.', '/docs/using/invoices/' ],
			[ 'Recurring invoices and subscriptions', 'Bill the same customer on a schedule without having to remember.', '/docs/using/recurring-invoices/' ],
			[ 'Credit notes', 'Refunds and corrections, kept against the invoice they belong to.', '/docs/using/credit-notes/' ],
			[ 'Card payments', 'Stripe, PayPal and Square. Your customer pays from the invoice; the payment records itself.', '/docs/running/payment-methods/' ],
			[ 'Offline payments', 'Bank transfer, cheque, or any arrangement of your own, with wording you control.', '/docs/running/payment-methods/' ],
			[ 'Multiple currencies', 'Invoice in the currency the customer deals in.', '/docs/using/currencies/' ],
			[ 'Finance', 'Income and expenses in one place, recurring entries for the bills you expect, and summary figures over the top.', '/docs/using/finance/' ],
		],
	},
	{
		heading: 'Talking to customers',
		items: [
			[ 'Customer portal', 'Your customers log in to see their own quotes, invoices and tickets, pay what they owe, and sign what needs signing.', '/docs/using/customer-portal/' ],
			[ 'Email templates', 'Every message the system sends is a template you can edit, with variables for the record it is about.', '/docs/using/templates/' ],
			[ 'Newsletters', 'Bulk email to your own lists, sent in batches so a host does not cut it off halfway.', '/docs/using/newsletters/' ],
			[ 'Files', 'Attach files to records and share them with the customer. Uploads are kept out of reach of the web.', '/docs/using/files/' ],
		],
	},
	{
		heading: 'Running the installation',
		items: [
			[ 'Staff and permissions', 'Staff accounts, roles, and per feature permissions.', '/docs/using/staff-and-permissions/' ],
			[ 'Multiple companies', 'Run more than one business from one installation.', '/docs/using/customers/' ],
			[ 'Dashboard', 'Figures and charts on the front page, arranged per user.', '/docs/using/dashboard/' ],
			[ 'Backups', 'Database and file backups you can schedule.', '/docs/using/backups/' ],
			[ 'Scheduled tasks', 'One cron entry drives recurring invoices, mailbox collection and newsletter batches.', '/docs/running/scheduled-tasks/' ],
			[ 'Translation', 'The interface text can be translated.', '/docs/running/configuration/' ],
			[ 'Themes', 'Several interface themes ship with it.', '/docs/developers/customising/' ],
		],
	},
];
---

<Base
	title="Features — Ultimate Client Manager"
	description="Everything Ultimate Client Manager does: customers, quotes, contracts, jobs, time tracking, invoices, payments, tickets, finance and a customer portal."
	current="/features/"
>
	<section class="hero">
		<div class="wrap narrow">
			<p class="kicker">Features</p>
			<h1>Everything it does</h1>
			<p class="lead">
				Each line links to the documentation article that explains it properly. All of
				that documentation is public, so you can read exactly how a feature behaves
				before you buy anything.
			</p>
		</div>
	</section>

	{
		sections.map( ( section, index ) => (
			<section class={ index % 2 === 0 ? 'tint' : undefined }>
				<div class="wrap">
					<h2>{ section.heading }</h2>
					<ul class="grid">
						{
							section.items.map( ( [ title, body, href ] ) => (
								<li class="card">
									<h3><a href={ href }>{ title }</a></h3>
									<p>{ body }</p>
								</li>
							) )
						}
					</ul>
				</div>
			</section>
		) )
	}

	<section>
		<div class="wrap narrow">
			<h2>Not listed here</h2>
			<p>
				Some things that shipped in earlier versions have been retired in this release —
				three payment gateways that can no longer take a payment, and Authorize.Net, which
				collected card numbers on your own server and put the merchant in the hardest tier
				of PCI compliance. Existing records still render; none of them is offered for new
				setup. <a href="/docs/running/payment-methods/">Payment methods</a> says which and
				why.
			</p>
			<div class="actions">
				<a class="button" href="https://codecanyon.net/item/freelance-project-invoice-crm/2621629">
					Buy on CodeCanyon
				</a>
				<a class="button quiet" href="/requirements/">Check your hosting first</a>
			</div>
		</div>
	</section>
</Base>
