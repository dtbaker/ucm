---
/**
 * The landing page.
 *
 * Written for one reader: somebody comparing this against a monthly CRM subscription and
 * trying to work out whether a self hosted PHP application is a reasonable thing to run.
 * Every claim is checkable against the documentation or the code.
 */
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';

const areas = [
	{
		title: 'Customers and leads',
		body: 'Companies, the people at them, addresses and custom fields. Leads and suppliers are customers with a different type, so nothing is a separate silo.',
		href: '/docs/using/customers/',
	},
	{
		title: 'Quotes and contracts',
		body: 'Build a quote from your product list, send it for approval, and have it signed online with a drawn signature. An approved quote becomes a job or an invoice.',
		href: '/docs/using/quotes/',
	},
	{
		title: 'Jobs and tasks',
		body: 'Break work into tasks, assign them to staff, track time against them, and invoice what was actually done.',
		href: '/docs/using/jobs/',
	},
	{
		title: 'Invoices and payments',
		body: 'Invoices, credit notes, tax, multiple currencies, and card payment through Stripe, PayPal or Square. Recurring invoices bill on a schedule without being remembered.',
		href: '/docs/using/invoices/',
	},
	{
		title: 'Time tracking',
		body: 'A timer that attaches recorded time to a job, a task or a ticket, and carries it through to the invoice.',
		href: '/docs/using/timers/',
	},
	{
		title: 'Support tickets',
		body: 'A ticket queue that can collect replies straight out of an email mailbox and file them against the right ticket.',
		href: '/docs/using/tickets/',
	},
	{
		title: 'Finance',
		body: 'Income and expenses in one place, recurring entries for bills you already know are coming, and summary figures over the top.',
		href: '/docs/using/finance/',
	},
	{
		title: 'A customer portal',
		body: 'Your customers log in to see their own quotes, invoices and tickets, pay what they owe, and sign what needs signing.',
		href: '/docs/using/customer-portal/',
	},
];
---

<Base
	title="Ultimate Client Manager — self hosted CRM, quoting and invoicing"
	description="A CRM, quoting, invoicing and job tracking system that runs on your own PHP and MySQL hosting. Buy it once, install it, and keep your data in your own database."
>
	<section class="hero">
		<div class="wrap">
			<p class="kicker">Self hosted. Bought once.</p>
			<h1>Your clients, quotes, jobs and invoices — on your own hosting.</h1>
			<p class="lead">
				Ultimate Client Manager is a CRM, quoting, invoicing and job tracking system you
				install on ordinary PHP and MySQL hosting. There is no monthly fee, no per seat
				price, and no company in the middle holding your customer list.
			</p>
			<div class="actions">
				<a class="button" href="https://codecanyon.net/item/freelance-project-invoice-crm/2621629">
					Buy on CodeCanyon
				</a>
				<a class="button quiet" href="/docs/">Read the documentation</a>
			</div>
			<p class="under">
				One payment of <Placeholder what="current CodeCanyon price" />. Runs on PHP 8.4 and
				MySQL — <a href="/requirements/">check your hosting</a> before you buy.
			</p>
		</div>
	</section>

	<section class="tint">
		<div class="wrap">
			<h2>What it replaces</h2>
			<p class="narrow">
				Most small firms end up paying for a CRM, a quoting tool, an invoicing tool and
				somewhere to track jobs, then paying again for every person who needs a login.
				This is one application that does all of it, and the price does not change when
				you hire somebody.
			</p>
			<div class="scroller">
				<table class="compare">
					<caption class="under" style="text-align: left; padding-bottom: 0.6rem;">
						How the two arrangements differ. The right hand column describes this software;
						the left describes the usual subscription model.
					</caption>
					<thead>
						<tr>
							<th scope="col"></th>
							<th scope="col">A hosted CRM</th>
							<th scope="col">Ultimate Client Manager</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">What you pay</th>
							<td>Every month, per person, forever</td>
							<td>Once</td>
						</tr>
						<tr>
							<th scope="row">Adding staff</th>
							<td>Costs more every time</td>
							<td>Costs nothing</td>
						</tr>
						<tr>
							<th scope="row">Where the data is</th>
							<td>Their servers, their jurisdiction</td>
							<td>Your database, on your hosting</td>
						</tr>
						<tr>
							<th scope="row">Getting the data out</th>
							<td>Whatever export they offer</td>
							<td>It is a MySQL database. Back it up, query it, move it</td>
						</tr>
						<tr>
							<th scope="row">Changing how it works</th>
							<td>Their roadmap</td>
							<td>Source included, and a <a href="/docs/developers/customising/">custom folder</a> for changes that survive updates</td>
						</tr>
						<tr>
							<th scope="row">If the vendor disappears</th>
							<td>You have a deadline</td>
							<td>It keeps running. It is on your server</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p style="margin-top: 1.4rem;">
				<a href="/self-hosted/">The longer argument, including the parts that count against it →</a>
			</p>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>What is in it</h2>
			<p class="narrow">
				Each area of the product is a plugin, so the parts you do not use can be switched
				off rather than cluttering the menu. <a href="/docs/developers/plugins/">Every
				plugin that ships</a> is listed in the documentation with its version.
			</p>
			<ul class="grid">
				{
					areas.map( ( area ) => (
						<li class="card">
							<h3><a href={ area.href }>{ area.title }</a></h3>
							<p>{ area.body }</p>
						</li>
					) )
				}
			</ul>
			<p style="margin-top: 1.6rem;"><a href="/features/">Everything it does, in detail →</a></p>
		</div>
	</section>

	<section class="tint">
		<div class="wrap narrow">
			<h2>See it before you buy</h2>
			<p>
				<Placeholder what="demo address and whether it is still open to the public" />
			</p>
			<p>
				The documentation is public and complete, so you can read exactly how a feature
				behaves before you spend anything —
				<a href="/docs/using/invoices/">invoicing</a>,
				<a href="/docs/running/payment-methods/">payment gateways</a> and
				<a href="/docs/install/requirements/">what your hosting needs</a> are the three
				worth reading first.
			</p>
			<p>
				<Placeholder what="screenshots of the current interface" />
			</p>
		</div>
	</section>

	<section>
		<div class="wrap narrow">
			<h2>Already running version 2?</h2>
			<p>
				This release raises the minimum PHP version and changes where database settings
				are stored, so it is not a files-over-the-top upgrade. The upgrade guide covers
				the order to do things in and what to back up first.
			</p>
			<div class="actions">
				<a class="button quiet" href="/docs/install/upgrading/">Read the upgrade guide</a>
			</div>
		</div>
	</section>
</Base>
