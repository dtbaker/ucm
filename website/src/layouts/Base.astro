---
/**
 * The frame every page sits in.
 *
 * Deliberately one file. A marketing site of six pages does not need a component
 * library, and the person maintaining this is the person who writes the PHP.
 */
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	/** The nav item to mark as the current page, eg '/features/'. */
	current?: string;
}

const { title, description, current = '' } = Astro.props;

const nav = [
	{ href: '/features/', label: 'Features' },
	{ href: '/self-hosted/', label: 'Why self hosted' },
	{ href: '/pricing/', label: 'Pricing' },
	{ href: '/requirements/', label: 'Requirements' },
	{ href: '/docs/', label: 'Documentation' },
	{ href: '/support/', label: 'Support' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{ title }</title>
		<meta name="description" content={ description } />
		<meta property="og:title" content={ title } />
		<meta property="og:description" content={ description } />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={ new URL( Astro.url.pathname, Astro.site ) } />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="masthead">
			<div class="wrap">
				<a class="wordmark" href="/">Ultimate <span>Client Manager</span></a>
				<nav aria-label="Main">
					{
						nav.map( ( item ) => (
							<a href={ item.href } aria-current={ current === item.href ? 'page' : undefined }>
								{ item.label }
							</a>
						) )
					}
				</nav>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site">
			<div class="wrap">
				<div class="cols">
					<div>
						<h2>The software</h2>
						<ul>
							<li><a href="/features/">Features</a></li>
							<li><a href="/self-hosted/">Why self hosted</a></li>
							<li><a href="/requirements/">Requirements</a></li>
							<li><a href="/pricing/">Pricing and licence</a></li>
						</ul>
					</div>
					<div>
						<h2>Documentation</h2>
						<ul>
							<li><a href="/docs/">All documentation</a></li>
							<li><a href="/docs/install/requirements/">Before you install</a></li>
							<li><a href="/docs/install/installing/">Installing</a></li>
							<li><a href="/docs/install/upgrading/">Upgrading from 2.x</a></li>
							<li><a href="/docs/reference/troubleshooting/">Troubleshooting</a></li>
						</ul>
					</div>
					<div>
						<h2>Help</h2>
						<ul>
							<li><a href="/support/">Getting support</a></li>
							<li>
								<a href="https://codecanyon.net/item/freelance-project-invoice-crm/2621629">
									The item on CodeCanyon
								</a>
							</li>
							<li><a href="https://github.com/dtbaker/ucm">Source on GitHub</a></li>
						</ul>
					</div>
				</div>
				<p class="fine">
					Ultimate Client Manager is self hosted software. It runs on your own hosting,
					stores its data in your own database, and sends nothing anywhere unless you
					configure it to.
				</p>
			</div>
		</footer>
	</body>
</html>
