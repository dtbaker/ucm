<?xml version="1.0"?>
<ruleset name="UCM Coding Standards">
    <description>PSR-12 coding standards for Ultimate Client Manager (relaxed for tabs and spaces-in-parens to match .php-cs-fixer.php)</description>

    <rule ref="PSR12">
        <!-- Allow tabs (project uses tabs per .php-cs-fixer.php) -->
        <exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <!-- Allow spaces in parentheses: func( $arg ), if ( $x ) (WordPress-style) -->
        <exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
        <exclude name="PSR2.Methods.FunctionCallSignature"/>
        <exclude name="Squiz.WhiteSpace.ControlStructureSpacing"/>
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
        <exclude name="Squiz.ControlStructures.ForEachLoopDeclaration.SpaceAfterOpen"/>
        <exclude name="Squiz.ControlStructures.ForEachLoopDeclaration.SpaceBeforeClose"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingAfterOpen"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingBeforeClose"/>
        <!-- Allow opening brace on same line (project style per .php-cs-fixer.php) -->
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="PSR2.Methods.FunctionClosingBrace.SpacingBeforeClose"/>
        <exclude name="Squiz.ControlStructures.ControlSignature.NewlineAfterOpenBrace"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace"/>
        <!-- Legacy codebase: relax naming/structure rules -->
        <exclude name="PSR1.Classes.ClassDeclaration"/>
        <exclude name="Squiz.Classes.ValidClassName"/>
        <exclude name="Generic.NamingConventions.CamelCapsFunctionName"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="Squiz.Scope.MethodScope"/>
        <exclude name="PSR1.Files.SideEffects"/>
        <!-- Ignore line length (legacy codebase) -->
        <exclude name="Generic.Files.LineLength"/>
        <!-- Legacy: property underscore prefix, constant visibility -->
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
        <exclude name="PSR12.Properties.ConstantVisibility"/>
    </rule>

    <file>includes</file>
    <!-- The front controllers used to sit outside every scan, which is how an eval() in
         ext.php went unnoticed for years. Scan them too. -->
    <file>ajax.php</file>
    <file>cron.php</file>
    <file>ext.php</file>
    <file>index.php</file>
    <file>init.php</file>

    <arg name="extensions" value="php"/>
    <arg name="tab-width" value="4"/>

    <!-- Local developer config, gitignored - not ours to lint -->
    <exclude-pattern>*/includes/config.local.php</exclude-pattern>

    <!-- Exclude third-party/vendor code (same as .php-cs-fixer.php) -->
    <exclude-pattern>*/plugin_pdf/dompdf/*</exclude-pattern>
    <exclude-pattern>*/plugin_encrypt/phpseclib/*</exclude-pattern>
    <exclude-pattern>*/plugin_security/htmlpurifier/*</exclude-pattern>
    <exclude-pattern>*/plugin_calendar/wdCalendar/*</exclude-pattern>
    <exclude-pattern>*/plugin_captcha/inc/*</exclude-pattern>
    <exclude-pattern>*/plugin_paymethod_stripe/stripe-php/*</exclude-pattern>
    <exclude-pattern>*/plugin_paymethod_authorize/anet_php_1.1.8/*</exclude-pattern>
    <exclude-pattern>*/plugin_paymethod_coinbase/lib/*</exclude-pattern>
    <exclude-pattern>*/plugin_paymethod_multisafepay/MultiSafepay.combined.php</exclude-pattern>
    <exclude-pattern>*/plugin_ticket/cron/mime_parser.php</exclude-pattern>
    <!-- HTML/template files with no or minimal PHP -->
    <exclude-pattern>*/plugin_change_request/pages/popup_content_0.php</exclude-pattern>
    <exclude-pattern>*/plugin_config/pages/config_payment.php</exclude-pattern>
    <exclude-pattern>*/plugin_customer/portal/login.php</exclude-pattern>
    <exclude-pattern>*/plugin_customer/portal/tickets.php</exclude-pattern>
    <exclude-pattern>*/plugin_finance/pages/finance_quick.php</exclude-pattern>
    <exclude-pattern>*/plugin_invoice/template/credit_note_pdf.php</exclude-pattern>
    <exclude-pattern>*/plugin_invoice/template/invoice_print.php</exclude-pattern>
    <exclude-pattern>*/plugin_invoice/template/invoice_print_basic.php</exclude-pattern>
    <exclude-pattern>*/plugin_paymethod_authorize/pages/authorize_form_default.php</exclude-pattern>
    <exclude-pattern>*/plugin_file/upload/index.php</exclude-pattern>
    <exclude-pattern>*/plugin_file/upload/plupload/index.php</exclude-pattern>
    <exclude-pattern>*/plugin_statistic/pages/statistic_list.php</exclude-pattern>
    <exclude-pattern>*/plugin_theme/themes/index.php</exclude-pattern>
    <exclude-pattern>*/plugin_theme_blocks/pages/home.php</exclude-pattern>
</ruleset>
