{
    "name": "ucm/ultimate-client-manager",
    "description": "Ultimate Client Manager - Freelance Project Invoice CRM",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ezyang/htmlpurifier": "^4.19",
        "stripe/stripe-php": "^22.0",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2"
    },
    "autoload": {
        "files": []
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:e2e": "npm run test:e2e",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "phpstan:baseline": "phpstan analyse --memory-limit=2G --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
        "phpcs": "phpcs -d memory_limit=2G",
        "phpcs:fix": "phpcbf -d memory_limit=2G"
    }
}
